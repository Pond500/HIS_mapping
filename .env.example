# Copy to .env and fill in. .env is gitignored — never commit it.

# Postgres (used by docker compose and the app)
POSTGRES_DB=his_mapping
POSTGRES_USER=his_admin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://his_admin:change-me@localhost:5432/his_mapping

# Host port for the app container (http://localhost:APP_PORT)
APP_PORT=8000

# Staff web pages (sign-in). APP_SECRET signs the session cookie; if it is empty the app
# creates storage/session_key on first run. SESSION_MINUTES = sign out after this long idle.
APP_SECRET=
SESSION_MINUTES=60

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
