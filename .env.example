# Copy to .env and fill in. .env is gitignored — never commit it.

# Postgres (used by docker compose and the app)
POSTGRES_DB=his_mapping
POSTGRES_USER=his_admin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://his_admin:change-me@localhost:5432/his_mapping

# Host port for the app container (http://localhost:APP_PORT)
APP_PORT=8000

# Staff web pages (sign-in). APP_SECRET signs the session cookie; if it is empty the app
# creates storage/session_key on first run. SESSION_MINUTES = sign out after this long idle.
APP_SECRET=
SESSION_MINUTES=60

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Language model behaviour (docs/deploy-demo.md, docs/demo.md)
#   live      call the model and record every answer in storage/llm_cache (rehearsal)
#   fallback  call the model; on error or after LLM_TIMEOUT_S use the recorded answer (the demo)
#   replay    never touch the network; recorded answers only
LLM_MODE=live
LLM_TIMEOUT_S=45
# a proposal is saved without asking only when both models agree, confidence is high and the
# values fit the column's plausible range. "__ignore__" is never auto-accepted.
AUTO_ACCEPT=on

# The old /api/legacy/upload route needs no sign-in and no longer matches the schema.
# It is OFF unless this is set, and a server must never set it.
# ENABLE_LEGACY_UPLOAD=on
